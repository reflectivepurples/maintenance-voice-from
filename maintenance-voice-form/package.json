const { PDFDocument } = require("pdf-lib");
const fs = require("fs");

exports.handler = async (event) => {
  const data = JSON.parse(event.body);
  const answers = data.answers;

  // Load your blank form
  const formPdfBytes = fs.readFileSync("./form-template.pdf");
  const pdfDoc = await PDFDocument.load(formPdfBytes);
  const form = pdfDoc.getForm();

  form.getTextField("JobNumber").setText(answers[0].answer);
  form.getTextField("TypeOfMaintenance").setText(answers[1].answer);
  // ...fill remaining fields

  const filledPdf = await pdfDoc.save();
  return {
    statusCode: 200,
    headers: { "Content-Type": "application/pdf" },
    body: Buffer.from(filledPdf).toString("base64"),
    isBase64Encoded: true,
  };
};
